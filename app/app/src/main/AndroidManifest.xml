<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!-- Polar SDK needs Bluetooth scan permission to search for BLE devices. Polar BLE SDK doesn't use the scan
 to decide the location so "neverForLocation" permission flag can be used.-->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Polar SDK needs Bluetooth connect permission to connect for found BLE devices.-->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Allows Polar SDK to connect to paired bluetooth devices. Legacy Bluetooth permission,
     which is needed on devices with API 30 (Android Q) or older. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- Allows Polar SDK to discover and pair bluetooth devices. Legacy Bluetooth permission,
     which is needed on devices with API 30 (Android Q) or older. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Polar SDK needs the fine location permission to get results for Bluetooth scan. Request
    fine location permission on devices with API 30 (Android Q). Note, if your application
    needs location for other purposes than bluetooth then remove android:maxSdkVersion="30"-->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Posizione approssimativa: fino ad Android 11 serve alla scansione Bluetooth (con la fine),
     da Android 12 SOLO alle previsioni del caldo (BioSleep, punto 7). Per questo qui non c'e'
     maxSdkVersion: con maxSdkVersion="30" il permesso non esisterebbe da Android 12 in poi e la
     richiesta verrebbe rifiutata senza mostrare nulla. La posizione precisa resta limitata ad API 30. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Allow MQTTDataSaver to publish data to MQTT broker -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />


    <!-- Permissions needed for staying active in the background, for long running recordings -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- BioSleep, notte protetta: CPU sveglia durante la registrazione e watchdog con allarme
         esatto ogni 10 minuti (anche in Doze), che puo' riavviare il servizio se il sistema lo chiude. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Protezione notturna (Parte 3): la registrazione dura 8 ore a schermo spento
         (dispositivo connesso). Uso dichiarato nella Play Console. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- BioSleep, avvio automatico: Android avvisa l'app quando la fascia associata compare
         e le permette di avviare la registrazione anche se l'app non e' aperta. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PolarRecorderApplication"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PolarRecorder"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Ritorno dal collegamento a Intervals.icu: App Link VERIFICATO sul dominio del
                 Worker (assetlinks.json). Solo questa app, firmata con la sua chiave, puo' aprirlo:
                 a differenza di uno schema biosleep:// che qualunque app potrebbe registrare. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="auth.noctalix.com"
                    android:path="/app" />
            </intent-filter>
            <!-- Collegamento di un browser (Parte 6): il QR di noctalix.com apre l'app -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="noctalix.com" android:path="/collega" />
            </intent-filter>
        </activity>
        <service
            android:name=".services.RecordingService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false"
            android:description="@string/recording_service_description" />

        <!-- BioSleep: riceve da Android "fascia comparsa / scomparsa" -->
        <service
            android:name=".biosleep.auto.StrapPresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- Notifica "Coach al lavoro": il servizio in primo piano di WorkManager, tipo dataSync -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- BioSleep: ricontrollo periodico delle condizioni di avvio automatico -->
        <!-- BioSleep: watchdog della notte (controllo, riavvio del servizio, chiusura) -->
        <receiver
            android:name=".biosleep.watchdog.AutoStopAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".biosleep.auto.AutoStartAlarmReceiver"
            android:exported="false" />
        <!-- Parte 5: condivisione delle card -->
    <activity
        android:name="com.wboelens.polarrecorder.biosleep.condivisione.CondivisioneActivity"
        android:exported="false"
        android:theme="@android:style/Theme.Material.NoActionBar" />
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.condivisione"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/condivisione_paths" />
    </provider>
          <!-- Scanner QR (ZXing): segue la rotazione del telefono -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
    </application>
</manifest>