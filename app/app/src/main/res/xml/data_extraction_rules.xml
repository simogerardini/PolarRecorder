<?xml version="1.0" encoding="utf-8"?>
<!-- Backup su cloud e trasferimento a nuovo telefono (Android 12+): esclude la API key di
     Intervals.icu, il token GitHub del coach e la cache -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="biosleep_intervals.xml" />
        <exclude domain="sharedpref" path="biosleep_coach.xml" />
        <exclude domain="database" path="biosleep_cache.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="biosleep_intervals.xml" />
        <exclude domain="sharedpref" path="biosleep_coach.xml" />
        <exclude domain="database" path="biosleep_cache.db" />
    </device-transfer>
</data-extraction-rules>
