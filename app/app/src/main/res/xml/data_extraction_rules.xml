<?xml version="1.0" encoding="utf-8"?>
<!-- Backup su cloud e trasferimento a nuovo telefono (Android 12+): esclude la API key di Intervals.icu -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="biosleep_intervals.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="biosleep_intervals.xml" />
    </device-transfer>
</data-extraction-rules>
