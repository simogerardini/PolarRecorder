<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 e precedenti (con allowBackup="false" non viene usato: resta come seconda difesa).
  Dati sanitari: nulla nel backup automatico di Google. Il backup e' quello cifrato dell'app.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
