<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automatico (Android 11 e precedenti): esclude la API key di Intervals.icu, il token
     GitHub del coach (cifrato con una chiave che non lascia il telefono) e la cache -->
<full-backup-content>
    <exclude domain="sharedpref" path="biosleep_intervals.xml" />
    <exclude domain="sharedpref" path="biosleep_coach.xml" />
    <exclude domain="database" path="biosleep_cache.db" />
</full-backup-content>
